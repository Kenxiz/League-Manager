# --- Required ---
# Bot token from https://discord.com/developers/applications  (NEVER commit this)
DISCORD_TOKEN=
# Application (client) ID
DISCORD_CLIENT_ID=

# --- Optional ---
# If set, slash commands deploy instantly to this guild only (great for development).
DEV_GUILD_ID=
# Comma-separated Discord user IDs with global bot-owner powers (maintenance, any guild).
BOT_OWNER_IDS=

# SQLite database file
DATABASE_PATH=./data/leaguebot.db

# debug | info | warn | error
LOG_LEVEL=info

# development | production
NODE_ENV=development

# Days of audit log kept before being pruned (0 = keep forever)
AUDIT_RETENTION_DAYS=90

# Brotli quality for compressed blobs (0-11). 5 is a good CPU/size balance.
COMPRESSION_LEVEL=5

# External API: Roblox thumbnails (turns the catalog's Roblox logo asset IDs into image URLs)
ROBLOX_THUMBNAILS_BASE=https://thumbnails.roblox.com/v1
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=3
